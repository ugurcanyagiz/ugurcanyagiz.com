---
import Layout from "../layouts/Layout.astro";

const sections = [
  { href: "/science", name: "Science", x: 23, y: 27, mobileX: 24, mobileY: 20, color: "#a8d9ff" },
  { href: "/history", name: "History", x: 74, y: 21, mobileX: 71, mobileY: 15, color: "#ffc47e" },
  { href: "/art", name: "Art", x: 83, y: 56, mobileX: 76, mobileY: 69, color: "#ffb7cd" },
  { href: "/future", name: "Future", x: 67, y: 79, mobileX: 58, mobileY: 84, color: "#c9f2d4" },
  { href: "/blog", name: "JLOG", x: 18, y: 68, mobileX: 16, mobileY: 72, color: "#f7d797" },
];

const stars = Array.from({ length: 72 }, (_, i) => ({
  x: (i * 137.508 + 31) % 100,
  y: (i * i * 17.137 + i * 11.73 + 8) % 100,
  opacity: 0.13 + (i % 7) * 0.07,
}));
---

<Layout title="Ugurcan Yagiz — Personal Atlas" description="Science, History, Art, Future and JLOG by Ugurcan Yagiz." hideChrome>
  <div class="ocean-home">
    <div class="starfield" aria-hidden="true">
      {stars.map(({ x, y, opacity }) => <i style={`--x:${x}%;--y:${y}%;--opacity:${opacity}`}></i>)}
    </div>

    <canvas class="cosmos" aria-hidden="true"></canvas>

    <nav class="constellation" aria-label="Explore Personal Atlas">
      <div class="planet" aria-hidden="true">
        <img src="/images/surreal-ocean-planet.webp" alt="" width="670" height="663" fetchpriority="high" />
        <canvas class="planet-surface" aria-hidden="true"></canvas>
        <span class="planet-current"></span>
        <span class="planet-light"></span>
      </div>

      <canvas class="connection" aria-hidden="true"></canvas>

      {sections.map(({ href, name, x, y, mobileX, mobileY, color }) => (
        <a class="section-star" href={href}
          style={`--x:${x}%;--y:${y}%;--mobile-x:${mobileX}%;--mobile-y:${mobileY}%;--star:${color}`}>
          <span class="star-light" aria-hidden="true"></span>
          <span>{name}</span>
        </a>
      ))}
    </nav>
  </div>
</Layout>

<style>
  .ocean-home {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-height: max(380px, 100svh);
    overflow: hidden;
    background: radial-gradient(ellipse at 49% 46%, #12182b 0%, #090e1d 52%, #030611 87%);
  }

  .starfield { position: absolute; inset: 0; pointer-events: none; }
  .starfield i {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 1px;
    height: 1px;
    border-radius: 50%;
    background: #e6e2f7;
    opacity: var(--opacity);
  }

  .cosmos { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .ocean-home[data-cosmos] .starfield { visibility: hidden; }

  .constellation {
    position: relative;
    width: min(100%, 1700px);
    height: min(100svh, 960px);
    min-height: 380px;
    --orbit-color: #0000;
    --light-x: 50%;
    --light-y: 50%;
  }

  .planet {
    position: absolute;
    left: 49%;
    top: 49%;
    width: min(40vw, 70svh, 670px);
    aspect-ratio: 670 / 663;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    overflow: hidden;
    touch-action: pan-y pinch-zoom;
    isolation: isolate;
    transition: transform .48s cubic-bezier(.23,.73,.19,1);
  }

  .planet img {
    display: block;
    width: 100%;
    height: 100%;
    animation: tide 9s ease-in-out infinite alternate;
  }

  .planet-surface { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; }
  .planet[data-webgl] { cursor: grab; }
  .planet[data-dragging] { cursor: grabbing; }
  .planet[data-webgl] .planet-surface { opacity: 1; }
  .planet[data-webgl] :is(img, .planet-current) { visibility: hidden; animation: none; }
  .constellation[data-travel] .planet { transform: translate(-50%, -50%) scale(1.18); }
  .constellation[data-travel="4"] .planet { transform: translate(-50%, -50%) scale(.78); }
  .constellation[data-travel] .section-star:not([data-lit]) { opacity: .42; }
  .section-star { transition: opacity .35s ease; }

  .planet-current {
    position: absolute;
    inset: -25%;
    background: linear-gradient(153deg, transparent 25%, #afbbff30 43%, #fff1d34d 49%, #9db1ff26 57%, transparent 70%);
    mix-blend-mode: screen;
    animation: current-drift 7s ease-in-out infinite alternate;
  }

  .planet-light {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle at var(--light-x) var(--light-y), var(--orbit-color), transparent 37%);
    mix-blend-mode: screen;
    opacity: 0;
    transition: opacity .16s ease;
  }

  .connection {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity .16s ease;
  }

  .constellation[data-active] :is(.connection, .planet-light) { opacity: 1; }

  .section-star {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: flex;
    gap: 13px;
    align-items: center;
    min-height: 48px;
    padding: 0 10px;
    transform: translate(-16px, -50%);
    border-radius: 9px;
    color: #f7f5ff;
    font: 500 clamp(.875rem, 1.3vw, 1.25rem)/1.2 system-ui, sans-serif;
    white-space: nowrap;
    text-shadow: 0 1px 8px #080d20;
    -webkit-tap-highlight-color: transparent;
  }

  .star-light {
    position: relative;
    flex: 0 0 12px;
    height: 12px;
    background: radial-gradient(circle, #fff 10%, var(--star) 24%, transparent 68%);
    filter: drop-shadow(0 0 5px var(--star));
    animation: twinkle 2.8s ease-in-out infinite alternate;
  }

  .section-star:nth-of-type(even) .star-light { animation-delay: -2.3s; }
  .star-light::before, .star-light::after {
    content: "";
    position: absolute;
    inset: 50% auto auto 50%;
    width: 27px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--star), transparent);
    transform: translate(-50%, -50%);
  }
  .star-light::after { transform: translate(-50%, -50%) rotate(90deg); }
  .section-star:is(:hover, :focus-visible) { color: var(--star); }
  .section-star:focus-visible { outline: 1px solid var(--star); outline-offset: 2px; }

  .section-star[data-lit] .star-light {
    animation: none;
    transform: scale(1.42);
    filter: drop-shadow(0 0 10px var(--star));
  }

  @keyframes tide {
    from { transform: rotate(-8deg) scale(1.04); }
    to { transform: rotate(9deg) scale(1.09); }
  }

  @keyframes current-drift {
    from { transform: translate(-8%, -19%); opacity: .34; }
    to { transform: translate(8%, 19%); opacity: .88; }
  }

  @keyframes twinkle {
    from { opacity: .56; transform: scale(.82); }
    to { opacity: 1; transform: scale(1.16); }
  }

  @media (max-width: 700px) {
    .planet { width: min(81vw, 55svh); top: 46%; }
    .section-star { left: var(--mobile-x); top: var(--mobile-y); gap: 8px; }
    .section-star:nth-of-type(2) { left: min(var(--mobile-x), calc(100% - 80px)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .planet img, .planet-current, .star-light { animation: none; }
    .planet-current { display: none; }
    .planet, .planet-light, .connection, .section-star { transition: none; }
  }
</style>


<script>
const nav = document.querySelector<HTMLElement>('.constellation');
const planet = nav?.querySelector<HTMLElement>('.planet');
const surface = planet?.querySelector<HTMLCanvasElement>('.planet-surface');
const image = planet?.querySelector<HTMLImageElement>('img');
const connection = nav?.querySelector<HTMLCanvasElement>('.connection');
const lines = connection?.getContext('2d');
const motion = matchMedia('(prefers-reduced-motion: reduce)');

const vertex = [
  'attribute vec2 position;',
  'varying vec2 screen;',
  'void main(){ screen=position; gl_Position=vec4(position,0.,1.); }'
].join('\n');

const fragment = [
  'precision mediump float;',
  'varying vec2 screen;',
  'uniform sampler2D painting;',
  'uniform vec2 turn;',
  'uniform float time, travel, mode;',
  'uniform vec3 tint;',
  'vec3 yaw(vec3 n,float a){float c=cos(a),s=sin(a);return vec3(c*n.x+s*n.z,n.y,-s*n.x+c*n.z);}',
  'vec3 pitch(vec3 n,float a){float c=cos(a),s=sin(a);return vec3(n.x,c*n.y-s*n.z,s*n.y+c*n.z);}',
  'void main(){',
  '  vec2 p=screen;',
  '  float radius=length(p);',
  '  if(radius>1.){gl_FragColor=vec4(0.);return;}',
  '  vec3 n=vec3(p,sqrt(max(0.,1.-dot(p,p))));',
  '  vec3 world=yaw(pitch(n,turn.y),turn.x);',
  '  float longitude=atan(world.x,world.z);',
  '  float latitudeWidth=sqrt(max(0.,1.-world.y*world.y));',
  '  vec2 q=vec2(atan(longitude*1.33)*.70*latitudeWidth,world.y);',
  '  q.x+=.008*sin(world.y*17.+time*1.25)*world.z;',
  '  q.y+=.006*sin(world.x*20.-time*.95)*world.z;',
  '  q*=min(1.,.972/max(length(q),.001));',
  '  vec2 uv=vec2(.5)+q*vec2(.489,-.489);',
  '  vec3 color=texture2D(painting,uv).rgb;',
  '  float light=.67+.43*max(0.,dot(n,normalize(vec3(-.48,.55,.85))));',
  '  color*=light;',
  '  color=mix(color,vec3(.065,.10,.23),pow(radius,4.)*.30);',
  '  float rim=smoothstep(.76,1.,radius)*smoothstep(-.7,.7,p.y-p.x*.4);',
  '  color+=vec3(.18,.30,.52)*rim*.55;',
  '  float wave=0.;',
  '  if(mode<.5){float d=length(world.xy-vec2(-.26,-.14));wave=pow(max(0.,cos(d*27.-travel*15.)),10.)*(1.-smoothstep(.1,.85,d));}',
  '  else if(mode<1.5){float grid=sin(world.x*31.+world.y*13.)*sin(world.y*26.);wave=pow(max(0.,grid),6.)*smoothstep(-.8,.7,world.y);}',
  '  else if(mode<2.5){wave=.5+.5*sin(world.y*13.+world.x*9.+travel*4.);}',
  '  else if(mode<3.5){float band=world.y-.36+.14*sin(world.x*8.+travel*5.);wave=exp(-abs(band)*13.)*smoothstep(-.2,.8,world.y);}',
  '  else {wave=rim*.85;}',
  '  color+=tint*wave*travel*.43;',
  '  gl_FragColor=vec4(color,1.-smoothstep(.987,1.,radius));',
  '}'
].join('\n');

function makeGlobe(canvas: HTMLCanvasElement, source: HTMLImageElement) {
  const gl = canvas.getContext('webgl', { alpha: true, antialias: false, premultipliedAlpha: false, powerPreference: 'low-power' });
  if (!gl) return null;
  const context = gl;

  function compile(type: number, code: string) {
    const shader = context.createShader(type);
    if (!shader) return null;
    context.shaderSource(shader, code);
    context.compileShader(shader);
    if (context.getShaderParameter(shader, context.COMPILE_STATUS)) return shader;
    context.deleteShader(shader);
    return null;
  }

  const vs = compile(gl.VERTEX_SHADER, vertex);
  const fs = compile(gl.FRAGMENT_SHADER, fragment);
  const program = gl.createProgram();
  const texture = gl.createTexture();
  const buffer = gl.createBuffer();
  if (!vs || !fs || !program || !texture || !buffer) return null;
  gl.attachShader(program, vs);
  gl.attachShader(program, fs);
  gl.linkProgram(program);
  gl.deleteShader(vs);
  gl.deleteShader(fs);
  if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return null;

  gl.useProgram(program);
  gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
  gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, 3,-1, -1,3]), gl.STATIC_DRAW);
  const position = gl.getAttribLocation(program, 'position');
  gl.enableVertexAttribArray(position);
  gl.vertexAttribPointer(position, 2, gl.FLOAT, false, 0, 0);
  gl.bindTexture(gl.TEXTURE_2D, texture);
  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
  gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, source);
  if (gl.getError() !== gl.NO_ERROR) return null;
  gl.uniform1i(gl.getUniformLocation(program, 'painting'), 0);

  const turn = gl.getUniformLocation(program, 'turn');
  const time = gl.getUniformLocation(program, 'time');
  const travel = gl.getUniformLocation(program, 'travel');
  const mode = gl.getUniformLocation(program, 'mode');
  const tint = gl.getUniformLocation(program, 'tint');

  return (x: number, y: number, t: number, amount: number, category: number, color: number[]) => {
    const density = Math.min(devicePixelRatio || 1, 1.5);
    const width = Math.min(900, Math.round(canvas.clientWidth * density));
    const height = Math.min(900, Math.round(canvas.clientHeight * density));
    if (width < 2 || height < 2) return;
    if (canvas.width !== width || canvas.height !== height) {
      canvas.width = width;
      canvas.height = height;
    }
    context.viewport(0, 0, width, height);
    context.uniform2f(turn, x, y);
    context.uniform1f(time, t);
    context.uniform1f(travel, amount);
    context.uniform1f(mode, category);
    context.uniform3f(tint, color[0], color[1], color[2]);
    context.drawArrays(context.TRIANGLES, 0, 3);
  };
}

if (nav && planet && surface && image && connection && lines) {
  const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('.section-star'));
  const moves = [[-.40,.20],[.51,.18],[.63,-.12],[.27,-.40],[-.33,-.26]];
  let renderer: ReturnType<typeof makeGlobe> = null;
  let hover: HTMLAnchorElement | null = null;
  let focus: HTMLAnchorElement | null = null;
  let active: HTMLAnchorElement | null = null;
  let lit: HTMLAnchorElement | null = null;
  let flight = 0;
  let navigation: number | undefined;
  let frame = 0;
  let lastFrame = 0;
  let x = 0, y = 0, goalX = 0, goalY = 0;
  let drag: {id:number,x:number,y:number} | null = null;

  const clamp = (value: number, limit: number) => Math.max(-limit, Math.min(limit, value));

  function drawLine() {
    const link = active ?? hover ?? focus;
    if (link !== lit) {
      lit?.removeAttribute('data-lit');
      link?.setAttribute('data-lit', '');
      lit = link;
    }
    const star = link?.querySelector('.star-light');
    if (!nav || !connection || !lines || !planet) return;
    if (!link || !star) { nav.removeAttribute('data-active'); return; }
    const bounds = nav.getBoundingClientRect();
    const globe = planet.getBoundingClientRect();
    const point = star.getBoundingClientRect();
    const cx = globe.left - bounds.left + globe.width / 2;
    const cy = globe.top - bounds.top + globe.height / 2;
    const sx = point.left - bounds.left + point.width / 2;
    const sy = point.top - bounds.top + point.height / 2;
    const dx = sx-cx, dy = sy-cy;
    const length = Math.hypot(dx / globe.width, dy / globe.height);
    if (!length) return;
    const reach = Math.min(1, .5 / length);
    const ex = cx + dx * reach, ey = cy + dy * reach;
    const color = link.style.getPropertyValue('--star');
    const density = Math.min(devicePixelRatio || 1, 2);
    const w = Math.round(bounds.width * density), h = Math.round(bounds.height * density);
    if (connection.width !== w || connection.height !== h) {
      connection.width = w;
      connection.height = h;
    }
    lines.setTransform(density,0,0,density,0,0);
    lines.clearRect(0,0,bounds.width,bounds.height);
    lines.beginPath();
    lines.moveTo(ex,ey);
    lines.quadraticCurveTo((ex+sx)/2+(sy-ey)*.24,(ey+sy)/2-(sx-ex)*.24,sx,sy);
    lines.strokeStyle = color;
    lines.lineWidth = 1.6;
    lines.shadowColor = color;
    lines.shadowBlur = 7;
    lines.stroke();
    nav.style.setProperty('--light-x', (50 + dx * reach / globe.width * 100) + '%');
    nav.style.setProperty('--light-y', (50 + dy * reach / globe.height * 100) + '%');
    nav.style.setProperty('--orbit-color', color);
    nav.setAttribute('data-active', '');
  }

  function schedule() {
    if (!frame && !document.hidden && !motion.matches) frame = requestAnimationFrame(draw);
  }

  function draw(now: number) {
    frame = 0;
    if (now - lastFrame >= 29) {
      lastFrame = now;
      const index = active ? links.indexOf(active) : -1;
      const amount = active ? Math.min(1, (now-flight)/480) : 0;
      const target = moves[index] ?? [goalX,goalY];
      x += (target[0] - x)*.19;
      y += (target[1] - y)*.19;
      const rgb = active ? parseInt(active.style.getPropertyValue('--star').trim().slice(1),16) : 0;
      const tint = [(rgb>>16)/255,((rgb>>8)&255)/255,(rgb&255)/255];
      const idle = drag || active ? 0 : Math.sin(now/4400)*.09;
      renderer?.(x+idle,y,(now/1000)%120,amount,index,tint);
      if (active) drawLine();
    }
    if (renderer || active) schedule();
  }

  function startGlobe() {
    if (!image || !surface || !planet || motion.matches || !image.naturalWidth || renderer) return;
    try { renderer = makeGlobe(surface,image); } catch { renderer = null; }
    if (!renderer) return;
    const bounds = planet.getBoundingClientRect();
    if (bounds.width < 2 || bounds.height < 2) { renderer = null; return; }
    renderer(0,0,0,0,-1,[0,0,0]);
    planet.dataset.webgl = '';
    schedule();
  }

  function stopGlobe() {
    renderer = null;
    planet?.removeAttribute('data-webgl');
  }

  function reset() {
    window.clearTimeout(navigation);
    active = null;
    hover = null;
    focus = null;
    drag = null;
    nav?.removeAttribute('data-travel');
    planet?.removeAttribute('data-dragging');
    drawLine();
  }

  for (const [index, link] of links.entries()) {
    link.addEventListener('pointerenter', event => {
      if (event.pointerType !== 'touch') { hover = link; drawLine(); }
    });
    link.addEventListener('pointerleave', () => { hover = null; drawLine(); });
    link.addEventListener('focus', () => { focus = link; drawLine(); });
    link.addEventListener('blur', () => { focus = null; drawLine(); });
    link.addEventListener('click', event => {
      if (event.defaultPrevented || motion.matches || event.button !== 0 ||
          event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      window.clearTimeout(navigation);
      active = link;
      nav.dataset.travel = String(index);
      flight = performance.now();
      drawLine();
      schedule();
      navigation = window.setTimeout(() => window.location.assign(link.href), 480);
    });
  }

  planet.addEventListener('pointerdown', event => {
    if (!renderer || !event.isPrimary || event.button !== 0 || active) return;
    drag = {id:event.pointerId,x:event.clientX,y:event.clientY};
    planet.setPointerCapture(event.pointerId);
    planet.dataset.dragging = '';
  });
  planet.addEventListener('pointermove', event => {
    if (drag?.id !== event.pointerId) return;
    goalX = clamp(goalX + (event.clientX-drag.x)*.008,.73);
    goalY = clamp(goalY + (event.clientY-drag.y)*.007,.48);
    drag.x = event.clientX;
    drag.y = event.clientY;
  });
  for (const eventName of ['pointerup','pointercancel','lostpointercapture']) {
    planet.addEventListener(eventName, () => {
      drag = null;
      planet.removeAttribute('data-dragging');
    });
  }
  surface.addEventListener('webglcontextlost', event => { event.preventDefault(); stopGlobe(); });
  surface.addEventListener('webglcontextrestored', startGlobe);
  motion.addEventListener('change', () => {
    if (!motion.matches) { startGlobe(); return; }
    stopGlobe();
    if (active) window.location.assign(active.href);
  });
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) { lastFrame = 0; schedule(); return; }
    cancelAnimationFrame(frame);
    frame = 0;
  });
  window.addEventListener('pagehide', reset);
  window.addEventListener('pageshow', schedule);
  new ResizeObserver(drawLine).observe(nav);
  if (image.complete) startGlobe();
  else image.addEventListener('load', startGlobe, {once:true});
}
</script>

<script>
const home = document.querySelector<HTMLElement>('.ocean-home');
const canvas = home?.querySelector<HTMLCanvasElement>('.cosmos');
const foreground = home?.querySelector<HTMLElement>('.planet');
const context = canvas?.getContext('2d');
const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

if (home && canvas && context) createCosmos(home, canvas, context, foreground);

function createCosmos(
  stage: HTMLElement,
  canvas: HTMLCanvasElement,
  ctx: CanvasRenderingContext2D,
  planet: HTMLElement | null | undefined,
) {
  type Star = { x: number; y: number; size: number; depth: number; phase: number; color: string };
  type Capture = { star: Star; angle: number; radius: number; elapsed: number; duration: number; direction: number };
  type Meteor = { x: number; y: number; elapsed: number; duration: number };

  const colors = ['190,214,255', '244,231,255', '255,207,157', '166,225,244'];
  const pointer = { x: 0, y: 0, active: false, ready: false };
  const hole = { x: 0, y: 0, visible: 0 };
  const nebula = document.createElement('canvas');
  const gas = nebula.getContext('2d');
  const stars: Star[] = [];
  const worlds = [0,1,2,3,4].map(paintWorld);
  let capture: Capture | null = null;
  let meteor: Meteor | null = null;
  let width = 0, height = 0;
  let elapsed = 0, nextCapture = 0, nextMeteor = 2.4;
  let frame = 0, lastFrame = 0;
  let suspended = false;
  let bounds = stage.getBoundingClientRect();
  let globe = planet?.getBoundingClientRect();

  function star(onEdge = false): Star {
    const position = Math.random();
    const edge = Math.floor(Math.random()*4);
    const clustered = !onEdge && Math.random()<.48;
    const band = .81-position*.60+Math.sin(position*7.1)*.092;
    const scatter = (Math.random()+Math.random()-1)*.49;
    const magnitude = Math.random();
    return {
      x: onEdge ? (edge === 0 ? .012 : edge === 1 ? .988 : position) : position,
      y: onEdge ? (edge === 2 ? .012 : edge === 3 ? .988 : position) : clustered ? Math.max(.02,Math.min(.98,band+scatter)) : Math.random(),
      size: magnitude < .014 ? 1.7 + Math.random()*1.05 : magnitude < .14 ? .93 + Math.random()*.63 : .22 + Math.random()*.69,
      depth: .18 + Math.random()*.82, phase: Math.random()*Math.PI*2,
      color: colors[Math.floor(Math.random()*colors.length)],
    };
  }

  function amber(x: number, y: number, radius: number, rgb: string, opacity: number) {
    const gradient = ctx.createRadialGradient(x,y,0,x,y,radius);
    gradient.addColorStop(0, 'rgba('+rgb+','+opacity+')');
    gradient.addColorStop(1, 'rgba('+rgb+',0)');
    ctx.fillStyle = gradient;
    ctx.fillRect(x-radius,y-radius,radius*2,radius*2);
  }


  function hash(x: number, y: number) {
    let n = Math.imul(x + 871, 374761393) ^ Math.imul(y - 913, 668265263);
    n = Math.imul(n ^ (n >>> 13), 1274126177);
    return ((n ^ (n >>> 16)) >>> 0) / 4294967295;
  }

  function noise(x: number, y: number) {
    const ix = Math.floor(x), iy = Math.floor(y);
    const xf = x - ix, yf = y - iy;
    const u = xf*xf*(3-2*xf), v = yf*yf*(3-2*yf);
    const a = hash(ix,iy), b = hash(ix,iy+1);
    return (a+(hash(ix+1,iy)-a)*u)*(1-v) + (b+(hash(ix+1,iy+1)-b)*u)*v;
  }

  function cloud(x: number, y: number) {
    return noise(x,y)*.52 + noise(x*2.08+9,y*2.08+12)*.26 +
      noise(x*4.31-4,y*4.31+19)*.14 + noise(x*9.27+18,y*9.27-17)*.08;
  }


  function paintWorld(kind: number) {
    if (!gas) return null;
    const sprite = document.createElement('canvas');
    const surface = sprite.getContext('2d');
    if (!surface) return null;
    const size = 144;
    const center = size/2;
    const radius = kind===0 ? 37 : 56;
    sprite.width = sprite.height = size;

    if (kind===0) {
      surface.save();
      surface.translate(center,center);
      surface.rotate(-.37);
      for (let i=0;i<12;i++) {
        surface.beginPath();
        surface.ellipse(0,0,46+i*1.59,11+i*.38,0,Math.PI,Math.PI*2);
        surface.strokeStyle = 'rgba(191,161,161,'+(.12+hash(i,26)*.30)+')';
        surface.lineWidth = .64+hash(i,73)*.68;
        surface.stroke();
      }
      surface.restore();
    }

    const pixels = surface.getImageData(0,0,size,size);
    const palette = [
      [[81,52,69],[219,179,137]],
      [[17,42,88],[104,188,207]],
      [[63,20,19],[244,149,88]],
      [[31,33,60],[181,153,206]],
      [[28,35,47],[176,185,194]]
    ][kind];
    for (let y=0;y<size;y++) {
      for (let x=0;x<size;x++) {
        const nx = (x+.5-center)/radius, ny = (center-y-.5)/radius;
        const distance = Math.hypot(nx,ny);
        if (distance>=1.015) continue;
        const nz = Math.sqrt(Math.max(0,1-distance*distance));
        const longitude = Math.atan2(nx,nz);
        const latitude = Math.asin(Math.max(-1,Math.min(1,ny)));
        const details = cloud(longitude*4+kind*17,latitude*5+kind*21);
        const small = cloud(longitude*10+kind,latitude*12+10);
        const bands = .5+.5*Math.sin(latitude*(kind===0?42:28)+details*2.7);
        const land = kind>1 ? details*.79+small*.21 : bands*.24+details*.76;
        const tint = Math.max(0,Math.min(1,(land-.31)*2.35));
        const day = Math.max(0,-nx*.61+ny*.36+nz*.69);
        const luminosity = .17+.92*Math.pow(day,.83);
        const rim = Math.pow(distance,11)*day;
        const alpha = Math.max(0,Math.min(1,(1.011-distance)*radius));
        const offset = (y*size+x)*4;
        for (let channel=0;channel<3;channel++) {
          const [dark,light]=palette;
          const color = (dark[channel]+(light[channel]-dark[channel])*tint)*luminosity+
            rim*[31,52,76][channel];
          pixels.data[offset+channel] = color*alpha+pixels.data[offset+channel]*(1-alpha);
        }
        pixels.data[offset+3] = Math.round(255*(alpha+(pixels.data[offset+3]/255)*(1-alpha)));
      }
    }
    surface.putImageData(pixels,0,0);

    if (kind===0) {
      surface.save();
      surface.translate(center,center);
      surface.rotate(-.37);
      for (let i=0;i<12;i++) {
        surface.strokeStyle = 'rgba(230,184,148,'+(.15+hash(i,28)*.37)+')';
        surface.lineWidth = .64+hash(i,73)*.68;
        surface.beginPath();
        surface.ellipse(0,0,46+i*1.59,11+i*.38,0,0,Math.PI);
        surface.stroke();
      }
      surface.restore();
    }
    return sprite;
  }

  function drawWorld(kind: number, x: number, y: number, size: number, angle = 0) {
    const sprite = worlds[kind];
    if (!sprite) return;
    if (!angle) { ctx.drawImage(sprite,x-size/2,y-size/2,size,size); return; }
    ctx.save();
    ctx.translate(x,y);
    ctx.rotate(angle);
    ctx.drawImage(sprite,-size/2,-size/2,size,size);
    ctx.restore();
  }

  function drawSun(x: number, y: number, radius: number) {
    const activity = .92+Math.sin(elapsed*.8)*.08;
    amber(x,y,radius*6.3,'237,113,63',.20*activity);
    amber(x,y,radius*3.7,'255,169,84',.39*activity);
    const disk = ctx.createRadialGradient(x-radius*.25,y-radius*.28,radius*.1,x,y,radius);
    disk.addColorStop(0,'#fffce2');
    disk.addColorStop(.68,'#ffdd9e');
    disk.addColorStop(.87,'#ffb263');
    disk.addColorStop(1,'#db5d39');
    ctx.fillStyle = disk;
    ctx.beginPath();
    ctx.arc(x,y,radius,0,Math.PI*2);
    ctx.fill();
    for (let i=0;i<9;i++) {
      const phase = i*2.39996+elapsed*.059;
      const distance = radius*(.22+hash(i,719)*.62);
      const px=x+Math.cos(phase)*distance, py=y+Math.sin(phase)*distance;
      ctx.fillStyle = 'rgba(173,68,32,'+(.10+hash(i,2)*.17)+')';
      ctx.fillRect(px,py,radius*.18,radius*.12);
    }
  }

  function drawSystem() {
    const small = width <= 650;
    const x = width*(small ? .78 : .882);
    const y = height*(small ? .921 : .782);
    const scale = Math.min(small ? 45 : 120, width*(small ? .118 : .095),height*(small ? .073 : .165));
    const tilt = -.29;
    const cosTilt = Math.cos(tilt), sinTilt = Math.sin(tilt);
    const bodies = [
      {kind:2, phase:2.04, distance:.39, speed:.48, size:.15},
      {kind:1, phase:4.32, distance:.72, speed:.31, size:.24},
      {kind:0, phase:.56, distance:1, speed:.205, size:.35}
    ].map(body => {
      const a = body.phase + elapsed*body.speed;
      const orbitX = Math.cos(a)*scale*body.distance;
      const orbitY = Math.sin(a)*scale*body.distance*.44;
      return {...body, orbitY, x:x+orbitX*cosTilt-orbitY*sinTilt, y:y+orbitX*sinTilt+orbitY*cosTilt};
    });
    for (const body of bodies) {
      ctx.strokeStyle = 'rgba(194,179,159,.15)';
      ctx.lineWidth = .62;
      ctx.beginPath();
      ctx.ellipse(x,y,scale*body.distance,scale*body.distance*.44,tilt,0,Math.PI*2);
      ctx.stroke();
    }
    const moonAngle = elapsed*.91+1.2;
    const showBody = (body: typeof bodies[number]) => {
      const size = body.size*scale*(1+body.orbitY/scale*.10);
      if (body.kind===1 && Math.sin(moonAngle)<0) {
        drawWorld(4,body.x+Math.cos(moonAngle)*size*.79,body.y+Math.sin(moonAngle)*size*.37,size*.27);
      }
      const lightAngle = Math.atan2(y-body.y,x-body.x)+2.61;
      drawWorld(body.kind,body.x,body.y,size,body.kind===0 ? 0 : lightAngle);
      if (body.kind===1 && Math.sin(moonAngle)>=0) {
        drawWorld(4,body.x+Math.cos(moonAngle)*size*.79,body.y+Math.sin(moonAngle)*size*.37,size*.27);
      }
    };
    for (const body of bodies) if (body.orbitY<0) showBody(body);
    drawSun(x,y,Math.max(5,scale*.091));
    for (const body of bodies) if (body.orbitY>=0) showBody(body);

    const drift = Math.sin(elapsed*.17);
    drawWorld(0,width*(.098+drift*.006),height*(small ? .69 : .79),scale*(small ? 1.37 : .93));
    drawWorld(3,width*(.907-drift*.004),height*(small ? .23 : .231),scale*(small ? .66 : .54));
  }

  function paintNebula() {
    if (!gas) return;
    nebula.width = width > 660 ? 680 : 350;
    nebula.height = Math.max(250, Math.min(900,Math.round(nebula.width*height/width)));
    const w = nebula.width, h = nebula.height;
    const image = gas.createImageData(w,h);
    const data = image.data;
    const clamp = (n: number) => Math.max(0,Math.min(1,n));
    for (let j=0;j<h;j++) {
      const y = j/(h-1);
      for (let i=0;i<w;i++) {
        const x = i/(w-1);
        const a = cloud(x*4+2,y*4+5);
        const b = cloud(x*5+12,y*5+8);
        const dust = cloud(x*9+(b-.5)*3.8,y*8+(a-.5)*4.1);
        const fine = noise(x*66+b*3,y*62+a*4);
        const diagonal = y - (.85-x*.65 + Math.sin(x*7.1)*.083 + (a-.49)*.49);
        const secondary = y - (.14+x*.58 + (b-.48)*.43);
        const ridge = Math.exp(-Math.abs(diagonal)*8.5);
        const veil = Math.exp(-Math.abs(secondary)*8)*.64;
        const darkLane = .44 + .56*clamp((Math.abs(diagonal+.028)+(dust-.5)*.13)*15);
        const structure = Math.pow(clamp(dust*1.22+fine*.18-.26),1.64);
        const filaments = Math.pow(1-Math.abs(2*dust-1),7)*ridge*.11;
        const ionizedGas = Math.pow(Math.max(0,dust-.43),2.1)*veil*.64;
        const intensity = (ridge*darkLane+veil*.74)*structure + filaments + ionizedGas + .065*b;
        const frontQuiet = .69+.31*clamp(Math.hypot((x-.5)*2,(y-.5)*1.4));
        const warm = clamp((x-.36)*1.29 + (a-.45)*.87);
        const blue = clamp((b-.24)*2.03);
        const fleck = hash(i,j)*1.9;
        const offset=(j*w+i)*4;
        data[offset] = 5+intensity*frontQuiet*(37+warm*225+blue*24)+fleck;
        data[offset+1] = 9+intensity*frontQuiet*(191-warm*109+blue*21)+fleck;
        data[offset+2] = 20+intensity*frontQuiet*(203+blue*70-warm*64)+fleck;
        data[offset+3] = 255;
      }
    }
    gas.putImageData(image,0,0);

  }

  function drawNebula() {
    if (!gas) return;
    const shiftX = Math.sin(elapsed*.075)*14+(pointer.ready ? (hole.x/width-.5)*13 : 0);
    const shiftY = Math.cos(elapsed*.064)*10+(pointer.ready ? (hole.y/height-.5)*8 : 0);
    const left = -22+shiftX, top = -18+shiftY;
    const imageWidth = width+44, imageHeight = height+36;
    ctx.drawImage(nebula,left,top,imageWidth,imageHeight);
    if (hole.visible < .018) return;

    const radius = horizon();
    const outer = radius*3.25;
    const tile = outer+radius*.5;
    const sourceLeft = (hole.x-tile-left)/imageWidth*nebula.width;
    const sourceTop = (hole.y-tile-top)/imageHeight*nebula.height;
    const sourceWidth = tile*2/imageWidth*nebula.width;
    const sourceHeight = tile*2/imageHeight*nebula.height;
    ctx.save();
    ctx.translate(hole.x,hole.y);
    for (let ring=8;ring>=0;ring--) {
      const edge = radius*(1.15+ring*.255);
      const bend = hole.visible*Math.exp(-edge/(radius*1.18));
      ctx.save();
      ctx.beginPath();
      ctx.arc(0,0,edge,0,Math.PI*2);
      ctx.clip();
      ctx.rotate(-bend*1.65);
      ctx.scale(1+bend*.83,1+bend*.83);
      ctx.globalAlpha = hole.visible*.46;
      ctx.drawImage(nebula,sourceLeft,sourceTop,sourceWidth,sourceHeight,-tile,-tile,tile*2,tile*2);
      ctx.restore();
    }
    ctx.restore();
  }

  function resize() {
    bounds = stage.getBoundingClientRect();
    globe = planet?.getBoundingClientRect();
    const w = stage.clientWidth, h = stage.clientHeight;
    if (!w || !h || (w === width && h === height)) return;
    width = w;
    height = h;
    const dpr = Math.min(devicePixelRatio || 1, 1.5);
    canvas.width = Math.round(w*dpr);
    canvas.height = Math.round(h*dpr);
    ctx.setTransform(canvas.width/w,0,0,canvas.height/h,0,0);
    const count = Math.max(690,Math.min(1730,Math.round(w*h/730)));
    while (stars.length < count) stars.push(star());
    if (stars.length > count) stars.length = count;
    if (capture && !stars.includes(capture.star)) capture = null;
    paintNebula();
    schedule();
  }

  function coordinates(s: Star): [number, number] {
    const dx = pointer.ready ? (hole.x-width/2)/width : 0;
    const dy = pointer.ready ? (hole.y-height/2)/height : 0;
    const x = s.x*width + Math.sin(elapsed*.22+s.phase)*s.depth*8 - dx*s.depth*25;
    const y = s.y*height + Math.cos(elapsed*.18+s.phase)*s.depth*6 - dy*s.depth*18;
    return [x,y];
  }

  function covered(x: number, y: number) {
    if (!globe || !globe.width || !globe.height) return false;
    const gx = x + bounds.left - globe.left - globe.width/2;
    const gy = y + bounds.top - globe.top - globe.height/2;
    return Math.hypot(gx/(globe.width/2), gy/(globe.height/2)) < 1.05;
  }

  function horizon() {
    return Math.min(22,Math.max(12,width*.017));
  }

  function beginCapture() {
    let candidate: Star | null = null;
    let bestScore = Infinity;
    let angle = 0, radius = 0;
    const reach = Math.min(294,Math.max(136,width*.23));
    for (const s of stars) {
      const [x,y] = coordinates(s);
      const d = Math.hypot(x-hole.x,y-hole.y);
      if (d < horizon()*1.28 || d > reach || covered(x,y)) continue;
      const score = d + (s.size < .95 ? 70 : -26);
      if (score >= bestScore) continue;
      candidate = s;
      bestScore = score;
      radius = d;
      angle = Math.atan2(y-hole.y,x-hole.x);
    }
    if (candidate) {
      capture = {star:candidate,angle,radius,elapsed:0,duration:1.85 + radius/235,direction:Math.random()<.5?-1:1};
    }
    nextCapture = elapsed + .36;
  }

  function moveHole(dt: number) {
    const follow = 1 - Math.exp(-dt*3.35);
    const fade = 1 - Math.exp(-dt*4.5);
    hole.x += (pointer.x-hole.x)*follow;
    hole.y += (pointer.y-hole.y)*follow;
    hole.visible += ((pointer.active?1:0)-hole.visible)*fade;
    if (capture) {
      capture.elapsed += dt;
      if (capture.elapsed >= capture.duration) {
        const index = stars.indexOf(capture.star);
        if (index >= 0) stars[index] = star(true);
        capture = null;
        nextCapture = elapsed + .31;
      }
    } else if (pointer.active && hole.visible > .42 && elapsed > nextCapture && !covered(hole.x,hole.y)) {
      beginCapture();
    }
  }

  function drawStars() {
    const radius = horizon();
    for (const s of stars) {
      if (s === capture?.star) continue;
      let [x,y] = coordinates(s);
      const dx = x-hole.x, dy = y-hole.y;
      const distance = Math.hypot(dx,dy);
      const lensing = hole.visible*.57*Math.exp(-distance/(radius*1.48));
      if (lensing > .035) {
        const angle = Math.atan2(dy,dx)-lensing;
        const out = distance+lensing*radius*.76;
        x = hole.x+Math.cos(angle)*out;
        y = hole.y+Math.sin(angle)*out;
      }
      const pulse = .65 + Math.sin(elapsed*(.58+s.depth*.72)+s.phase)*.29;
      const opacity = pulse*(.23+s.depth*.73);
      ctx.fillStyle = 'rgba('+s.color+','+opacity+')';
      if (s.size < .90) ctx.fillRect(x-s.size*.5,y-s.size*.5,s.size,s.size);
      else {
        ctx.beginPath();
        ctx.arc(x,y,s.size*.78,0,Math.PI*2);
        ctx.fill();
      }
      if (s.size > 1.69) {
        ctx.fillStyle = 'rgba('+s.color+','+pulse*.39+')';
        ctx.fillRect(x-s.size*2.3,y-.36,s.size*4.6,.72);
        ctx.fillRect(x-.36,y-s.size*1.75,.72,s.size*3.5);
      }
    }
  }

  function drawMeteor(dt: number) {
    if (!meteor && elapsed >= nextMeteor) {
      meteor = {x:width*(.17+Math.random()*.78),y:height*(.08+Math.random()*.37),elapsed:0,duration:.94+Math.random()*.43};
    }
    if (!meteor) return;
    meteor.elapsed += dt;
    const p = meteor.elapsed/meteor.duration;
    if (p >= 1) {
      meteor = null;
      nextMeteor = elapsed + 3.4 + Math.random()*4.1;
      return;
    }
    const x = meteor.x-230*p, y = meteor.y+93*p;
    const alpha = Math.sin(Math.PI*p)*.78;
    const tail = ctx.createLinearGradient(x+98,y-40,x,y);
    tail.addColorStop(0,'rgba(132,157,255,0)');
    tail.addColorStop(.75,'rgba(161,206,255,'+alpha*.47+')');
    tail.addColorStop(1,'rgba(227,244,255,'+alpha+')');
    ctx.strokeStyle = tail;
    ctx.lineWidth = 1.45;
    ctx.beginPath();
    ctx.moveTo(x+98,y-40);
    ctx.lineTo(x,y);
    ctx.stroke();
    amber(x,y,7,'170,208,255',alpha*.53);
  }

  function drawCaptured() {
    if (!capture) return;
    const p = Math.min(1,capture.elapsed/capture.duration);
    const radius = capture.radius+(horizon()*.87-capture.radius)*p*p;
    const angle = capture.angle+capture.direction*(p*.32+p*p*2.85);
    const dx = Math.cos(angle), dy = Math.sin(angle);
    const x = hole.x+dx*radius, y = hole.y+dy*radius;
    const stretch = 5 + (24+horizon())*p*p;
    const width = Math.max(1.1,capture.star.size*1.35)*(2.03-p*1.53);
    const alpha = hole.visible*(1-Math.max(0,(p-.88)/.12));
    const tail = ctx.createLinearGradient(x+dx*stretch,y+dy*stretch,x-dx*width,y-dy*width);
    tail.addColorStop(0,'rgba(255,123,172,0)');
    tail.addColorStop(.56,'rgba('+capture.star.color+','+alpha*.73+')');
    tail.addColorStop(1,'rgba(255,244,224,'+alpha+')');
    ctx.strokeStyle = tail;
    ctx.lineWidth = width;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(x+dx*stretch,y+dy*stretch);
    ctx.quadraticCurveTo(x+dx*stretch*.43-dy*p*8,y+dy*stretch*.43+dx*p*8,x-dx*width,y-dy*width);
    ctx.stroke();
    ctx.lineCap = 'butt';
    amber(x,y,9+p*17,capture.star.color,alpha*.55);
  }

  function drawHole() {
    if (hole.visible < .012) return;
    const {x,y,visible} = hole;
    const radius = horizon();
    const pulse = capture ? Math.pow(capture.elapsed/capture.duration,4) : 0;
    amber(x-radius*.44,y-radius*.2,radius*2.3,'29,149,186',visible*(.22+pulse*.12));
    amber(x+radius*.46,y+radius*.43,radius*2.19,'229,87,46',visible*(.15+pulse*.25));
    ctx.save();
    ctx.translate(x,y);
    ctx.globalAlpha = visible;

    const softEdge = ctx.createRadialGradient(0,0,radius*.82,0,0,radius*1.145);
    softEdge.addColorStop(0,'#000106');
    softEdge.addColorStop(.59,'rgba(0,1,6,.985)');
    softEdge.addColorStop(.76,'rgba(2,4,11,.56)');
    softEdge.addColorStop(1,'rgba(2,4,11,0)');
    ctx.fillStyle = softEdge;
    ctx.fillRect(-radius*1.15,-radius*1.15,radius*2.3,radius*2.3);

    for (let ring=0;ring<73;ring++) {
      const seed = hash(ring,11);
      const shade = hash(ring,26);
      const distance = radius*(.998+hash(ring,44)*.65);
      const from = seed*Math.PI*2+(ring%2 ? 1 : -.46)*elapsed*.16;
      const alpha = (.09+shade*.29)*Math.exp(-(distance/radius-1)*2.9);
      const tint = Math.sin(from+.28)>.12 ? (shade>.68?'255,187,115':'215,106,85') :
        (shade>.73?'199,237,243':'65,167,195');
      ctx.strokeStyle = 'rgba('+tint+','+alpha+')';
      ctx.lineWidth = .25 + shade*1.15;
      ctx.beginPath();
      ctx.arc(0,0,distance,from,from+.07+shade*.56);
      ctx.stroke();
    }
    ctx.strokeStyle = 'rgba(195,220,220,.32)';
    ctx.lineWidth = .95 + pulse*.7;
    ctx.beginPath();
    ctx.arc(0,0,radius*1.042,3.06,5.56);
    ctx.stroke();
    ctx.strokeStyle = 'rgba(255,173,120,.44)';
    ctx.beginPath();
    ctx.arc(0,0,radius*1.051,.04,2.12);
    ctx.stroke();
    ctx.restore();
  }

  function draw(time: number) {
    frame = 0;
    const dt = lastFrame ? Math.min(.08,(time-lastFrame)/1000) : 1/60;
    if (lastFrame && time-lastFrame < 29) { schedule(); return; }
    lastFrame = time;
    elapsed += dt;
    if (width && height) {
      moveHole(dt);
      ctx.clearRect(0,0,width,height);
      drawNebula();
      drawSystem();
      drawStars();
      drawMeteor(dt);
      drawCaptured();
      drawHole();
    }
    schedule();
  }

  function schedule() {
    if (!frame && !suspended && !document.hidden && !reducedMotion.matches) frame = requestAnimationFrame(draw);
  }

  function stop() {
    cancelAnimationFrame(frame);
    frame = 0;
    lastFrame = 0;
  }

  function applyMotion() {
    if (reducedMotion.matches) {
      stop();
      stage.removeAttribute('data-cosmos');
        ctx.clearRect(0,0,width,height);
      return;
    }
    stage.dataset.cosmos = '';
    schedule();
  }

  stage.addEventListener('pointermove', event => {
    if (event.pointerType !== 'mouse' && event.pointerType !== 'pen' || reducedMotion.matches) return;
    bounds = stage.getBoundingClientRect();
    pointer.x = event.clientX-bounds.left;
    pointer.y = event.clientY-bounds.top;
    if (!pointer.ready || hole.visible < .025) {
      hole.x = pointer.x;
      hole.y = pointer.y;
      nextCapture = elapsed + .47;
    }
    pointer.ready = pointer.active = true;
  }, {passive:true});
  stage.addEventListener('pointerleave', () => { pointer.active = false; });
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) { pointer.active = false; stop(); }
    else schedule();
  });
  window.addEventListener('pagehide', () => { suspended = true; pointer.active = false; stop(); });
  window.addEventListener('pageshow', () => { suspended = false; schedule(); });
  reducedMotion.addEventListener('change', applyMotion);
  new ResizeObserver(resize).observe(stage);
  resize();
  applyMotion();
}
</script>
