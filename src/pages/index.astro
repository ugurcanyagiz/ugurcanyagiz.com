---
import Layout from "../layouts/Layout.astro";

const sections = [
  { href: "/science", name: "Science", x: 23, y: 27, mobileX: 24, mobileY: 20, color: "#a8d9ff" },
  { href: "/history", name: "History", x: 74, y: 21, mobileX: 71, mobileY: 15, color: "#ffc47e" },
  { href: "/art", name: "Art", x: 83, y: 56, mobileX: 76, mobileY: 69, color: "#ffb7cd" },
  { href: "/future", name: "Future", x: 67, y: 79, mobileX: 58, mobileY: 84, color: "#c9f2d4" },
  { href: "/blog", name: "JLOG", x: 18, y: 68, mobileX: 16, mobileY: 72, color: "#f7d797" },
];

const stars = Array.from({ length: 72 }, (_, i) => ({
  x: (i * 137.508 + 31) % 100,
  y: (i * i * 17.137 + i * 11.73 + 8) % 100,
  opacity: 0.13 + (i % 7) * 0.07,
}));
---

<Layout title="Ugurcan Yagiz — Personal Atlas" description="Science, History, Art, Future and JLOG by Ugurcan Yagiz." hideChrome>
  <div class="ocean-home">
    <div class="starfield" aria-hidden="true">
      {stars.map(({ x, y, opacity }) => <i style={`--x:${x}%;--y:${y}%;--opacity:${opacity}`}></i>)}
    </div>

    <nav class="constellation" aria-label="Explore Personal Atlas">
      <div class="planet" aria-hidden="true">
        <img src="/images/surreal-ocean-planet.webp" alt="" width="670" height="663" fetchpriority="high" />
        <span class="planet-current"></span>
        <span class="planet-light"></span>
      </div>

      <canvas class="connection" aria-hidden="true"></canvas>

      {sections.map(({ href, name, x, y, mobileX, mobileY, color }) => (
        <a class="section-star" href={href}
          style={`--x:${x}%;--y:${y}%;--mobile-x:${mobileX}%;--mobile-y:${mobileY}%;--star:${color}`}>
          <span class="star-light" aria-hidden="true"></span>
          <span>{name}</span>
        </a>
      ))}
    </nav>
  </div>
</Layout>

<style>
  .ocean-home {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-height: max(380px, 100svh);
    overflow: hidden;
    background: radial-gradient(ellipse at 49% 46%, #202b51 0%, #111831 42%, #080d20 80%);
  }

  .starfield { position: absolute; inset: 0; pointer-events: none; }
  .starfield i {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 1px;
    height: 1px;
    border-radius: 50%;
    background: #e6e2f7;
    opacity: var(--opacity);
  }

  .constellation {
    position: relative;
    width: min(100%, 1700px);
    height: min(100svh, 960px);
    min-height: 380px;
    --orbit-color: #0000;
    --light-x: 50%;
    --light-y: 50%;
  }

  .planet {
    position: absolute;
    left: 49%;
    top: 49%;
    width: min(40vw, 70svh, 670px);
    aspect-ratio: 670 / 663;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    overflow: hidden;
    pointer-events: none;
  }

  .planet img {
    display: block;
    width: 100%;
    height: 100%;
    animation: tide 9s ease-in-out infinite alternate;
  }

  .planet-current {
    position: absolute;
    inset: -25%;
    background: linear-gradient(153deg, transparent 25%, #afbbff30 43%, #fff1d34d 49%, #9db1ff26 57%, transparent 70%);
    mix-blend-mode: screen;
    animation: current-drift 7s ease-in-out infinite alternate;
  }

  .planet-light {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle at var(--light-x) var(--light-y), var(--orbit-color), transparent 37%);
    mix-blend-mode: screen;
    opacity: 0;
    transition: opacity .16s ease;
  }

  .connection {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity .16s ease;
  }

  .constellation[data-active] :is(.connection, .planet-light) { opacity: 1; }

  .section-star {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: flex;
    gap: 13px;
    align-items: center;
    min-height: 48px;
    padding: 0 10px;
    transform: translate(-16px, -50%);
    border-radius: 9px;
    color: #f7f5ff;
    font: 500 clamp(.875rem, 1.3vw, 1.25rem)/1.2 system-ui, sans-serif;
    white-space: nowrap;
    text-shadow: 0 1px 8px #080d20;
    -webkit-tap-highlight-color: transparent;
  }

  .star-light {
    position: relative;
    flex: 0 0 12px;
    height: 12px;
    background: radial-gradient(circle, #fff 10%, var(--star) 24%, transparent 68%);
    filter: drop-shadow(0 0 5px var(--star));
    animation: twinkle 2.8s ease-in-out infinite alternate;
  }

  .section-star:nth-of-type(even) .star-light { animation-delay: -2.3s; }
  .star-light::before, .star-light::after {
    content: "";
    position: absolute;
    inset: 50% auto auto 50%;
    width: 27px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--star), transparent);
    transform: translate(-50%, -50%);
  }
  .star-light::after { transform: translate(-50%, -50%) rotate(90deg); }
  .section-star:is(:hover, :focus-visible) { color: var(--star); }
  .section-star:focus-visible { outline: 1px solid var(--star); outline-offset: 2px; }

  .section-star[data-lit] .star-light {
    animation: none;
    transform: scale(1.42);
    filter: drop-shadow(0 0 10px var(--star));
  }

  @keyframes tide {
    from { transform: rotate(-8deg) scale(1.04); }
    to { transform: rotate(9deg) scale(1.09); }
  }

  @keyframes current-drift {
    from { transform: translate(-8%, -19%); opacity: .34; }
    to { transform: translate(8%, 19%); opacity: .88; }
  }

  @keyframes twinkle {
    from { opacity: .56; transform: scale(.82); }
    to { opacity: 1; transform: scale(1.16); }
  }

  @media (max-width: 700px) {
    .planet { width: min(81vw, 55svh); top: 46%; }
    .section-star { left: var(--mobile-x); top: var(--mobile-y); gap: 8px; }
    .section-star:nth-of-type(2) { left: min(var(--mobile-x), calc(100% - 80px)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .planet img, .planet-current, .star-light { animation: none; }
    .planet-current { display: none; }
    .planet-light, .connection { transition: none; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>(".constellation");
  const canvas = nav?.querySelector<HTMLCanvasElement>(".connection");
  const planet = nav?.querySelector<HTMLElement>(".planet");
  const context = canvas?.getContext("2d");

  if (nav && canvas && planet && context) {
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>(".section-star"));
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    let tapped: HTMLAnchorElement | null = null;
    let lit: HTMLAnchorElement | null = null;
    let touchLink: HTMLAnchorElement | null = null;
    let navigationTimer: number | undefined;
    let hovered: HTMLAnchorElement | null = null;
    let focused: HTMLAnchorElement | null = null;

    function draw() {
      if (!nav || !canvas || !planet || !context) return;
      const link = tapped ?? hovered ?? focused;
      if (link !== lit) {
        lit?.removeAttribute("data-lit");
        link?.setAttribute("data-lit", "");
        lit = link;
      }
      const star = link?.querySelector(".star-light");
      if (!link || !star) {
        nav.removeAttribute("data-active");
        return;
      }

      const bounds = nav.getBoundingClientRect();
      const globe = planet.getBoundingClientRect();
      const point = star.getBoundingClientRect();
      const centerX = globe.left - bounds.left + globe.width / 2;
      const centerY = globe.top - bounds.top + globe.height / 2;
      const starX = point.left - bounds.left + point.width / 2;
      const starY = point.top - bounds.top + point.height / 2;
      const dx = starX - centerX;
      const dy = starY - centerY;
      const reach = 0.5 / Math.hypot(dx / globe.width, dy / globe.height);
      const edgeX = centerX + dx * reach;
      const edgeY = centerY + dy * reach;
      const color = link.style.getPropertyValue("--star");

      const scale = Math.min(devicePixelRatio, 2);
      canvas.width = Math.round(bounds.width * scale);
      canvas.height = Math.round(bounds.height * scale);
      context.scale(scale, scale);
      context.beginPath();
      context.moveTo(edgeX, edgeY);
      context.quadraticCurveTo(
        (edgeX + starX) / 2 + (starY - edgeY) * .24,
        (edgeY + starY) / 2 - (starX - edgeX) * .24,
        starX, starY,
      );
      context.strokeStyle = color;
      context.lineWidth = 1.6;
      context.shadowColor = color;
      context.shadowBlur = 7;
      context.stroke();

      nav.style.setProperty("--light-x", `${50 + dx * reach / globe.width * 100}%`);
      nav.style.setProperty("--light-y", `${50 + dy * reach / globe.height * 100}%`);
      nav.style.setProperty("--orbit-color", color);
      nav.setAttribute("data-active", "");
    }

    for (const link of links) {
      link.addEventListener("pointerdown", (event) => {
        touchLink = event.pointerType === "touch" ? link : null;
      });
      link.addEventListener("pointercancel", () => { touchLink = null; });
      link.addEventListener("click", (event) => {
        const isTouchTap = touchLink === link && event.detail > 0;
        touchLink = null;
        if (!isTouchTap || reducedMotion.matches || event.defaultPrevented ||
          event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        window.clearTimeout(navigationTimer);
        tapped = link;
        draw();
        navigationTimer = window.setTimeout(() => window.location.assign(link.href), 320);
      });
      link.addEventListener("pointerenter", (event) => {
        if (event.pointerType !== "touch") {
          hovered = link;
          draw();
        }
      });
      link.addEventListener("pointerleave", () => { hovered = null; draw(); });
      link.addEventListener("focus", () => { focused = link; draw(); });
      link.addEventListener("blur", () => { focused = null; draw(); });
    }

    window.addEventListener("pagehide", () => {
      window.clearTimeout(navigationTimer);
      tapped = null;
      hovered = null;
      focused = null;
      touchLink = null;
      draw();
    });
    new ResizeObserver(draw).observe(nav);
  }
</script>
